# ── Netlify Database ──────────────────────────────────────────────────────────
# On Netlify this is set automatically. For local work, point it at any
# Postgres database with netlify/database/migrations applied (see README).
NETLIFY_DB_URL=postgresql://postgres:postgres@localhost:5432/hfc_board

# ── File storage ──────────────────────────────────────────────────────────────
# On Netlify, files go to Netlify Blobs automatically. Locally, keep them in a
# folder instead. Never set this on Netlify.
LOCAL_STORAGE_DIR=.data/blobs

# ── Resend (sign-in codes and notices) ────────────────────────────────────────
# Leave unset locally: in `npm run dev` the sign-in code is printed in the terminal.
# RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=board@harrisonfaith.org

# ── App ───────────────────────────────────────────────────────────────────────
# Primary canonical URL — used in emails and by the scheduled job
APP_URL=https://board.harrisonfaith.church
NEXT_PUBLIC_APP_URL=https://board.harrisonfaith.church
# Timezone for background job date formatting
TIMEZONE=America/Chicago

# ── Cron (background jobs) ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET env var set on Netlify
CRON_SECRET=<secret>

# ── One-time move from Supabase (remove after the move) ───────────────────────
# Only the /api/migrate/supabase route reads these.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
