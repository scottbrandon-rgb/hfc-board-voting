# ── Database ──────────────────────────────────────────────────────────────────
# On Netlify the database connection is provided automatically (NETLIFY_DB_URL).
# For local development, point at a local PostgreSQL database with the
# migrations in netlify/database/migrations applied:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hfc_board

# ── Files ─────────────────────────────────────────────────────────────────────
# On Netlify, files live in Netlify Blobs. Locally, keep them in a folder:
HFC_LOCAL_FILES=.data/files

# ── Resend (sign-in codes and notices) ────────────────────────────────────────
# Leave empty locally: sign-in codes are then printed in the terminal.
RESEND_API_KEY=
RESEND_FROM_EMAIL=board@harrisonfaith.org

# ── App ───────────────────────────────────────────────────────────────────────
# Primary canonical URL — used in emails
APP_URL=https://board.harrisonfaith.church
NEXT_PUBLIC_APP_URL=https://board.harrisonfaith.church
# Timezone for background job date formatting
TIMEZONE=America/Chicago

# ── Cron (background jobs) ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET env var set on Netlify
CRON_SECRET=<secret>

# ── One-time move from Supabase (/setup/import) ───────────────────────────────
# Only needed until the records have been copied. Remove afterwards.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
